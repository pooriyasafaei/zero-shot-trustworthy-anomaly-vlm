#!/usr/bin/env bash
# Live dashboard for the TZ-SAD jobs on the remote Kaggle session.
#   tools/watch              live, refreshes every 20s
#   tools/watch --once       single snapshot
#   tools/watch -n 60        slower refresh
#   tools/watch --logs qwen  tail one job's log
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/.venv/bin/python" "$HERE/kaggle_monitor.py" "$@"
